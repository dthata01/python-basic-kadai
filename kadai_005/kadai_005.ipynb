      "source": [
        "'''\n",
        "課題5\n",
        "台形の面積を求めるプログラム\n",
        "'''\n",
        "# 上辺：10cm\n",
        "traps_top = 10\n",
        "# 下辺：20cm\n",
        "traps_bot = 20\n",
        "# 高さ：5cm\n",
        "traps_hit = 5\n",
        "\n",
        "# 公式：台形の面積 =（上辺＋下辺）× 高さ ÷ 2\n",
        "area = (traps_top + traps_bot) * traps_hit / 2\n",
        "print(f\" 台形の面積は {area} ㎠\")"
      ]
    }
  ]
}